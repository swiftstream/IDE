import Droid

final class MainActivity: AppCompatActivity {
    override class var exported: Bool? { true }
    override class var theme: Style? { .material3DayNightNoActionBar }
    override class var intentFilters: [IntentFilter] { [.mainLauncher] }
    
    let fabId = nextViewId()
    let fragmentContainerId = nextViewId()
    lazy var containerLayout = CoordinatorLayout(id: fragmentContainerId)

    @State var toolbarTitle: String = ""

    override func buildUI() {
        let actionBarSize = actionBarSize()
        window()?.statusBarColor(.transparent)
                 .navigationBarColor(.transparent)
        body {
            CoordinatorLayout {
                AppBarLayout {
                    MaterialToolbar()
                        .width(.matchParent)
                        .height(actionBarSize, .px)
                        .title($toolbarTitle)
                        .scrollFlags(.noScroll)
                }
                .width(.matchParent)
                .height(.wrapContent)
                .fitsSystemWindows()
                containerLayout
                    .width(.matchParent)
                    .height(.matchParent)
                    .marginTop(actionBarSize, .px)
                FloatingActionButton(id: fabId)
                    .width(.wrapContent)
                    .height(.wrapContent)
                    .gravity([.bottom, .end])
                    .marginBottom(16)
                    .marginRight(16)
                    .imageResource(android.R.drawable.ic_dialog_email)
                    .onClick { event in
                        Snackbar.make(event.view, "Replace with your own action", .long)
                            .action("Action") {
                                print("Snackbar action clicked")
                            }
                            .textColor(.cyan)
                            .animationMode(.slide)
                            .show()
                    }
            }
            .width(.matchParent)
            .height(.matchParent)
            .fitsSystemWindows()
        }
    }

    override func onStart() {
        super.onStart()
        supportFragmentManager()
            .beginTransaction()
            .reorderingAllowed()
            .replace(containerViewId: containerLayout.id, fragment: FragmentOne(self))
            .commit()
    }

    func navigateToSecondFragment() {
        supportFragmentManager()
            .beginTransaction()
            .reorderingAllowed()
            .replace(containerViewId: containerLayout.id, fragment: FragmentTwo(self))
            .addToBackStack(name: "second_fragment") // Add to back stack for back navigation
            .commit()
    }

    func navigateToFirstFragment() {
        supportFragmentManager()
            .beginTransaction()
            .reorderingAllowed()
            .replace(containerViewId: containerLayout.id, fragment: FragmentOne(self))
            .addToBackStack(name: "first_fragment") // Add to back stack for back navigation
            .commit()
    }
}


final class FragmentOne: Fragment {
    weak var activity: MainActivity?

    init (_ activity: MainActivity) {
        self.activity = activity
        super.init()
    }

    required init(_ object: JObject) {
        self.activity = nil
        super.init(object)
    }

    let buttonId = nextViewId()
    let textViewId = nextViewId()

    override func buildUI() {
        super.buildUI()
        body {
            NestedScrollView {
                ConstraintLayout {
                    MaterialButton(id: self.buttonId, "Next")
                        .width(.wrapContent)
                        .height(.wrapContent)
                        .bottomToTop(self.textViewId)
                        .endToEnd()
                        .startToStart()
                        .topToTop()
                        .onClick {
                            self.activity?.navigateToSecondFragment()
                        }
                    TextView(id: self.textViewId, String.fragmentTextOne)
                        .width(.matchParent)
                        .height(.matchParent)
                        .bottomToBottom()
                        .endToEnd()
                        .startToStart()
                        .topToBottom(self.buttonId)
                        .marginTop(16)
                }
                .padding()
            }
            .behavior(AppBarLayout.ScrollingViewBehavior())
        }
    }

    override func onStart() {
        super.onStart()
        self.activity?.toolbarTitle = "Fragment One"
    }
}

final class FragmentTwo: Fragment {
    weak var activity: MainActivity?

    init (_ activity: MainActivity) {
        self.activity = activity
        super.init()
    }

    required init(_ object: JObject) {
        self.activity = nil
        super.init(object)
    }

    let buttonId = nextViewId()
    let textViewId = nextViewId()

    override func buildUI() {
        super.buildUI()
        body {
            NestedScrollView {
                ConstraintLayout {
                    MaterialButton(id: self.buttonId, "Previous")
                        .width(.wrapContent)
                        .height(.wrapContent)
                        .bottomToTop(self.textViewId)
                        .endToEnd()
                        .startToStart()
                        .topToTop()
                        .onClick {
                            self.activity?.navigateToFirstFragment()
                        }
                    TextView(id: self.textViewId, String.fragmentTextTwo)
                        .width(.matchParent)
                        .height(.matchParent)
                        .bottomToBottom()
                        .endToEnd()
                        .startToStart()
                        .topToBottom(self.buttonId)
                        .marginTop(16)
                }
                .padding()
            }
            .behavior(AppBarLayout.ScrollingViewBehavior())
        }
    }

    override func onStart() {
        super.onStart()
        self.activity?.toolbarTitle = "Fragment Two"
    }
}

